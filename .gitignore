# Repository-wide ignores
# Keep broad, shared editor/build junk here so all language projects inherit it.
# Project-specific generated files should stay in that project's own .gitignore.

# Visual Studio / IDE state
.vs/
**/.vs/
**/.idea/
**/.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.vsidx
*.VC.db
*.VC.db-shm
*.VC.db-wal
*.VC.VC.opendb
*.opendb
*.db
*.db-shm
*.db-wal
*.ipch
*.pch
*.aps
*.pdb
*.obj
*.ilk
*.idb
*.tlog
*.lastbuildstate
*.recipe
*.FileListAbsolute.txt
*.Build.CppClean.log
*.VC.db*

# Build outputs and generated artifacts
**/x64/
**/build/
**/build-*/
**/out/
**/bin/
**/obj/
**/Debug/
**/Release/
**/*.obj
**/*.o
**/*.exe
**/*.dll
**/*.lib
**/*.exp
**/*.pdb
**/*.ilk
**/*.idb
**/*.ipch
**/*.pch
**/*.aps
**/*.tlog
**/*.lastbuildstate
**/*.recipe
**/*.FileListAbsolute.txt
**/*.Build.CppClean.log
**/*.VC.VC.opendb

# Logs and temp files
*.log
*.tmp
*.temp
*.cache
Thumbs.db
.DS_Store
Desktop.ini

